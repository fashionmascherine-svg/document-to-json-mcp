# LLM API (OpenAI-compatible) — provider-agnostic, fill with your provider's values
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=your-model-name
LLM_BASE_URL=https://api.your-llm-provider.com/v1

# x402 — Il tuo wallet USDC su Base mainnet
# Crea/usa il wallet che hai su MetaMask
X402_WALLET_ADDRESS=0xYourWalletAddressOnBaseMainnet
X402_NETWORK=eip155:8453

# Per test su Base Sepolia (testnet)
# X402_NETWORK=eip155:84532

# Limiti
MAX_FILE_SIZE_MB=20
MAX_PAGES=50
DEFAULT_LANGUAGE=eng+ita+spa
